<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SFCleaner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SFCleaner">

    <Grid x:Name="RootGrid" RequestedTheme="Dark" Padding="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="🦊 SilverFox Cleaner" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="银狐 (dmo/client) 检测清除 · SYSTEM + TrustedInstaller 提权 · 隔离区 C:\ProgramData\sf_quarantine"
                       Opacity="0.65" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button x:Name="BtnScan" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Find"/>
                    <TextBlock Text="扫描"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnClean" Click="Clean_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete"/>
                    <TextBlock Text="清除"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnQuar" Click="Quar_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Folder"/>
                    <TextBlock Text="隔离区"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnWipe" Click="Wipe_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Remove"/>
                    <TextBlock Text="清空隔离区"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnNomore" Click="Nomore_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Shield"/>
                    <TextBlock Text="不客气"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnExtreme" Click="Extreme_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="ReportHacked"/>
                    <TextBlock Text="☢ 极端模式"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnAbout" Click="About_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Help"/>
                    <TextBlock Text="关于"/>
                </StackPanel>
            </Button>
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" Margin="8,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="LvFindings" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Finding">
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="14,8" Margin="0,2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Head}" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Action}" FontSize="12" Opacity="0.55" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="TblEmpty"
                       Text="[OK] 未发现银狐痕迹 — 点击「扫描」开始检测"
                       Opacity="0.5" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Expander Grid.Row="3" Header="日志" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBox x:Name="TbLog"
                     IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="12"
                     Height="170" TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"/>
        </Expander>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="TblStats" FontWeight="SemiBold"/>
            <TextBlock x:Name="TblStatus" Opacity="0.55"
                       Text="就绪 — 点击扫描开始检测"/>
        </StackPanel>
    </Grid>
</Window>
